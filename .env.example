# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-5.5
# Terminal logging: INFO (previews) or DEBUG (full tool results)
LOG_LEVEL=INFO
# Long-term memory (lessons + past incidents). Default: data/memory.db
ITSM_MEMORY_DB_PATH=
# Desk time zone for current_time and business hours (Mon-Fri 08:00-18:00). Default: server local time
DESK_TIMEZONE=
# Demo world loaded on first start / reset: cache-outage (default) or major-incident
# ITSM_SCENARIO=major-incident
